# OceanIQ Backend Environment Variables
# Copy this file to .env and fill in your keys: cp .env.example .env

# Database Configuration (Neon PostgreSQL or local PostgreSQL)
POSTGRES_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# LLM Providers (At least one required for synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Model Routing ("groq" or "gemini")
LLM_PRIMARY=groq
LLM_FALLBACK=gemini

# ChromaDB Vector Store
CHROMA_PATH=./chroma_db
COLLECTION_NAME=argo_profiles_metadata
EMBED_MODEL=all-MiniLM-L6-v2

# Server Configuration
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Geocoding & Cache
NOMINATIM_USER_AGENT=oceaniq-dashboard
GEOCODE_CACHE_SIZE=128
CHAT_MEMORY_LIMIT=20
